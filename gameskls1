    /* ==========================================================================
       2. NAVIGATION & SCREEN CONTROLLERS
       ========================================================================== */

    function startGame(e) {
      e.preventDefault();
      const nameInput = document.getElementById('student-name').value.trim();
      const classInput = document.getElementById('student-class').value;

      if (!nameInput || !classInput) return;

      studentData.name = nameInput;
      studentData.class = classInput;

      // Update Header Stats
      document.getElementById('stat-student-name').innerText = studentData.name;
      document.getElementById('header-stats').classList.remove('hidden');

      // Switch to level screen
      showScreen('screen-levels');
      renderLevelGrid();
    }

    function showIdentityScreen() {
      showScreen('screen-identity');
      document.getElementById('header-stats').classList.add('hidden');
    }

    function showScreen(screenId) {
      const screens = ['screen-identity', 'screen-levels', 'screen-game', 'screen-level-complete'];
      screens.forEach(id => {
        const el = document.getElementById(id);
        if (id === screenId) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    }

    function renderLevelGrid() {
      const grid = document.getElementById('level-grid');
      grid.innerHTML = '';

      gameLevels.forEach((lvl, idx) => {
        const isUnlocked = levelUnlocked[idx];
        const score = levelScores[idx];

        const card = document.createElement('div');
        card.className = `clay-card p-4 text-center flex flex-col justify-between relative overflow-hidden transition transform hover:-translate-y-1 ${
          isUnlocked ? 'cursor-pointer' : 'opacity-60 cursor-not-allowed'
        }`;

        card.innerHTML = `
          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-xs font-black px-2 py-0.5 rounded-full ${isUnlocked ? 'bg-yellow-400 text-purple-950' : 'bg-gray-600 text-gray-300'}">
                LEVEL ${lvl.level}
              </span>
              ${isUnlocked ? `<span class="text-xs font-bold text-green-300"><i class="fa-solid fa-star"></i> ${score}/100</span>` : '<i class="fa-solid fa-lock text-purple-300"></i>'}
            </div>
            <h4 class="font-fredoka text-base text-white mb-1">${lvl.title}</h4>
            <p class="text-xs text-purple-200">${lvl.typeName}</p>
          </div>
          <button class="mt-4 clay-btn ${isUnlocked ? 'clay-btn-yellow text-purple-950' : 'bg-gray-700 text-gray-400'} py-2 text-xs font-bold w-full"
                  ${isUnlocked ? `onclick="loadLevel(${idx})"` : 'disabled'}>
            ${isUnlocked ? (score > 0 ? 'MAIN LAGI' : 'MULAI') : 'TERKUNCI'}
          </button>
        `;

        grid.appendChild(card);
      });
    }

    function backToLevels() {
      showScreen('screen-levels');
      renderLevelGrid();
    }

    /* ==========================================================================
       3. QUIZ ENGINE LOGIC
       ========================================================================== */

    function loadLevel(levelIdx) {
      currentLevelIndex = levelIdx;
      currentQuestionIndex = 0;
      showScreen('screen-game');
      renderQuestion();
    }

    function renderQuestion() {
      const level = gameLevels[currentLevelIndex];
      const q = level.questions[currentQuestionIndex];

      // Update Header Info
      document.getElementById('quiz-level-badge').innerText = `LEVEL ${level.level}`;
      document.getElementById('quiz-type-title').innerText = level.typeName;
      document.getElementById('quiz-progress').innerText = `${currentQuestionIndex + 1} / ${level.questions.length}`;

      // Reset Feedback
      const feedback = document.getElementById('quiz-feedback');
      feedback.className = 'hidden mb-4 p-3 rounded-xl text-center font-bold text-sm';
      feedback.innerText = '';

      // Visual & Question
      document.getElementById('quiz-visual').innerHTML = q.visual || '';
      document.getElementById('quiz-question-text').innerText = q.question;

      // Render Options based on Type
      const container = document.getElementById('quiz-options-container');
      container.innerHTML = '';

      selectedMultiAnswers = [];
      selectedMatchingPair = { left: null, right: null };
      matchingUserPairs = {};

      if (level.type === 'single') {
        renderSingleChoice(q, container);
      } else if (level.type === 'boolean') {
        renderBooleanChoice(q, container);
      } else if (level.type === 'matching') {
        renderMatchingChoice(q, container);
      } else if (level.type === 'multi') {
        renderMultiChoice(q, container);
      }
    }

    // Single Choice Renderer
    function renderSingleChoice(q, container) {
      const wrapper = document.createElement('div');
      wrapper.className = 'grid grid-cols-1 sm:grid-cols-3 gap-3';

      q.options.forEach((opt, i) => {
        const btn = document.createElement('button');
        btn.className = 'quiz-opt-btn clay-btn clay-btn-purple py-3 px-4 text-sm text-white font-bold text-left flex items-center justify-start space-x-2';
        btn.innerHTML = `<span class="w-6 h-6 rounded-full bg-purple-900 border border-white flex items-center justify-center text-xs">${String.fromCharCode(65 + i)}</span> <span>${opt.text}</span>`;
        btn.onclick = () => {
          document.querySelectorAll('.quiz-opt-btn').forEach(b => {
            b.classList.remove('ring-4', 'ring-yellow-400', 'bg-purple-600');
          });
          btn.classList.add('ring-4', 'ring-yellow-400');
          btn.dataset.selected = 'true';
          btn.dataset.correct = opt.correct;
        };
        wrapper.appendChild(btn);
      });

      container.appendChild(wrapper);
    }

    // Boolean Choice Renderer
    function renderBooleanChoice(q, container) {
      const wrapper = document.createElement('div');
      wrapper.className = 'flex justify-center space-x-4';

      q.options.forEach(opt => {
        const btn = document.createElement('button');
        const isTrue = opt.value === true;
        btn.className = `quiz-bool-btn clay-btn ${isTrue ? 'clay-btn-green' : 'clay-btn-pink'} py-4 px-8 text-base text-white font-black tracking-wider flex items-center space-x-2`;
        btn.innerHTML = `<span>${opt.text}</span> <i class="fa-solid ${isTrue ? 'fa-check' : 'fa-xmark'}"></i>`;
        btn.onclick = () => {
          document.querySelectorAll('.quiz-bool-btn').forEach(b => b.classList.remove('ring-4', 'ring-yellow-300'));
          btn.classList.add('ring-4', 'ring-yellow-300');
          btn.dataset.selected = 'true';
          btn.dataset.val = opt.value;
        };
        wrapper.appendChild(btn);
      });

      container.appendChild(wrapper);
    }

    // Matching Choice Renderer
    function renderMatchingChoice(q, container) {
      const wrapper = document.createElement('div');
      wrapper.className = 'grid grid-cols-2 gap-4';

      const leftCol = document.createElement('div');
      leftCol.className = 'space-y-3';
      const rightCol = document.createElement('div');
      rightCol.className = 'space-y-3';

      // Shuffle right items for puzzle element
      const shuffledRight = [...q.pairs].sort(() => Math.random() - 0.5);

      q.pairs.forEach(p => {
        const item = document.createElement('div');
        item.className = 'matching-box p-3 rounded-2xl bg-purple-900/50 text-center font-bold text-xs sm:text-sm cursor-pointer select-none';
        item.innerText = p.leftText;
        item.dataset.id = p.leftId;
        item.onclick = () => selectMatchingItem('left', p.leftId, item);
        leftCol.appendChild(item);
      });

      shuffledRight.forEach(p => {
        const item = document.createElement('div');
        item.className = 'matching-box p-3 rounded-2xl bg-purple-900/50 text-center font-bold text-xs sm:text-sm cursor-pointer select-none';
        item.innerText = p.rightText;
        item.dataset.id = p.rightId;
        item.onclick = () => selectMatchingItem('right', p.rightId, item);
        rightCol.appendChild(item);
      });

      wrapper.appendChild(leftCol);
      wrapper.appendChild(rightCol);
      container.appendChild(wrapper);

      const instruction = document.createElement('p');
      instruction.className = 'text-center text-xs text-yellow-300 mt-2 font-semibold';
      instruction.innerText = '👉 Klik 1 item di kiri, lalu klik pasangannya di kanan!';
      container.appendChild(instruction);
    }

    function selectMatchingItem(side, id, el) {
      if (side === 'left') {
        document.querySelectorAll('#quiz-options-container .matching-box').forEach(box => {
          if (box.parentElement.previousElementSibling === null) box.classList.remove('selected');
        });
        selectedMatchingPair.left = id;
        el.classList.add('selected');
      } else {
        document.querySelectorAll('#quiz-options-container .matching-box').forEach(box => {
          if (box.parentElement.previousElementSibling !== null) box.classList.remove('selected');
        });
        selectedMatchingPair.right = id;
        el.classList.add('selected');
      }

      // If both selected, pair them
      if (selectedMatchingPair.left && selectedMatchingPair.right) {
        matchingUserPairs[selectedMatchingPair.left] = selectedMatchingPair.right;
        
        // Visual indicator paired
        const leftEl = document.querySelector(`[data-id="${selectedMatchingPair.left}"]`);
        const rightEl = document.querySelector(`[data-id="${selectedMatchingPair.right}"]`);
        
        if (leftEl && rightEl) {
          leftEl.classList.remove('selected');
          rightEl.classList.remove('selected');
          leftEl.classList.add('matched');
          rightEl.classList.add('matched');
        }

        selectedMatchingPair = { left: null, right: null };
      }
    }

    // Multi Choice Renderer
    function renderMultiChoice(q, container) {
      const wrapper = document.createElement('div');
      wrapper.className = 'grid grid-cols-1 sm:grid-cols-2 gap-3';

      q.options.forEach(opt => {
        const btn = document.createElement('div');
        btn.className = 'clay-btn clay-btn-purple p-3 text-sm text-white font-bold cursor-pointer flex items-center space-x-3';
        btn.innerHTML = `
          <div class="clay-checkbox" id="chk-${opt.id}">
            <i class="fa-solid fa-check text-white text-xs hidden"></i>
          </div>
          <span>${opt.text}</span>
        `;
        btn.onclick = () => {
          const chk = document.getElementById(`chk-${opt.id}`);
          const icon = chk.querySelector('i');
          
          if (selectedMultiAnswers.includes(opt.id)) {
            selectedMultiAnswers = selectedMultiAnswers.filter(id => id !== opt.id);
            chk.classList.remove('clay-checkbox-active');
            icon.classList.add('hidden');
          } else {
            selectedMultiAnswers.push(opt.id);
            chk.classList.add('clay-checkbox-active');
            icon.classList.remove('hidden');
          }
        };
        wrapper.appendChild(btn);
      });

      container.appendChild(wrapper);
    }

    /* ==========================================================================
       4. ANSWER CHECKING & SCORING
       ========================================================================== */

    function checkAnswer() {
      const level = gameLevels[currentLevelIndex];
      const q = level.questions[currentQuestionIndex];
      const feedback = document.getElementById('quiz-feedback');

      let isCorrect = false;

      if (level.type === 'single') {
        const selectedBtn = document.querySelector('.quiz-opt-btn[data-selected="true"]');
        if (!selectedBtn) {
          showFeedback(false, "Pilih salah satu jawaban terlebih dahulu!");
          return;
        }
        isCorrect = (selectedBtn.dataset.correct === 'true');
      } 
      else if (level.type === 'boolean') {
        const selectedBtn = document.querySelector('.quiz-bool-btn[data-selected="true"]');
        if (!selectedBtn) {
          showFeedback(false, "Pilih BENAR atau SALAH!");
          return;
        }
        const val = selectedBtn.dataset.val === 'true';
        isCorrect = (val === q.correct);
      } 
      else if (level.type === 'matching') {
        // Check if all pairs mapped correctly (L1->R1, L2->R2, L3->R3)
        let totalPairs = q.pairs.length;
        let correctPairs = 0;
        
        q.pairs.forEach(p => {
          if (matchingUserPairs[p.leftId] === p.rightId) {
            correctPairs++;
          }
        });

        if (Object.keys(matchingUserPairs).length < totalPairs) {
          showFeedback(false, "Jodohkan semua pasangan angka di kiri dan kanan!");
          return;
        }

        isCorrect = (correctPairs === totalPairs);
      } 
      else if (level.type === 'multi') {
        if (selectedMultiAnswers.length === 0) {
          showFeedback(false, "Pilih setidaknya jawaban yang menurutmu benar!");
          return;
        }

        const correctIds = q.options.filter(o => o.correct).map(o => o.id);
        const isMatch = selectedMultiAnswers.length === correctIds.length &&
                        selectedMultiAnswers.every(id => correctIds.includes(id));
        isCorrect = isMatch;
      }

      // Show Result Feedback
      if (isCorrect) {
        showFeedback(true, "🎉 Luar Biasa! Jawabanmu TEPAT SEKALI!");
        confetti({ particleCount: 40, spread: 60, origin: { y: 0.8 } });
      } else {
        showFeedback(false, `❌ Kurang tepat! ${q.explanation || 'Yuk coba konsentrasi lagi!'}`);
      }

      // Proceed after delay
      setTimeout(() => {
        if (isCorrect) {
          // Increment Level Points
          const pointsPerQ = 100 / level.questions.length;
          levelScores[currentLevelIndex] += pointsPerQ;
        }

        currentQuestionIndex++;

        if (currentQuestionIndex < level.questions.length) {
          renderQuestion();
        } else {
          finishLevel();
        }
      }, 1800);
    }

    function showFeedback(isSuccess, message) {
      const feedback = document.getElementById('quiz-feedback');
      feedback.classList.remove('hidden', 'bg-green-500/30', 'text-green-200', 'bg-red-500/30', 'text-red-200');
      
      if (isSuccess) {
        feedback.classList.add('bg-green-500/30', 'text-green-200', 'border', 'border-green-400');
      } else {
        feedback.classList.add('bg-red-500/30', 'text-red-200', 'border', 'border-red-400');
      }
      feedback.innerText = message;
    }

    function finishLevel() {
      // Unlock Next Level
      if (currentLevelIndex + 1 < gameLevels.length) {
        levelUnlocked[currentLevelIndex + 1] = true;
      }

      // Update Total Score
      const totalScoreSum = levelScores.reduce((a, b) => a + b, 0) / gameLevels.length;
      studentData.score = Math.round(totalScoreSum);
      document.getElementById('stat-score').innerText = studentData.score;

      // Check if ALL levels completed
      const allDone = levelUnlocked.every((u, i) => u && levelScores[i] > 0) || (currentLevelIndex === gameLevels.length - 1);

      if (allDone) {
        showCertificateModal();
      } else {
        // Show Level Complete Screen
        document.getElementById('level-complete-score').innerText = `${Math.round(levelScores[currentLevelIndex])} / 100`;
        showScreen('screen-level-complete');
      }
    }

    function nextLevel() {
      if (currentLevelIndex + 1 < gameLevels.length) {
        loadLevel(currentLevelIndex + 1);
      } else {
        showCertificateModal();
      }
    }

    /* ==========================================================================
       5. CERTIFICATE GENERATOR
       ========================================================================== */

    function showCertificateModal() {
      const totalScore = studentData.score;
      let predicate = "CUKUP";
      let badgeBg = "bg-blue-400 text-purple-950";

      if (totalScore >= 85) {
        predicate = "AMAT BAIK";
        badgeBg = "bg-amber-400 text-purple-950";
      } else if (totalScore >= 70) {
        predicate = "BAIK";
        badgeBg = "bg-green-400 text-purple-950";
      }

      document.getElementById('cert-student-name').innerText = studentData.name.toUpperCase();
      document.getElementById('cert-student-class').innerText = `Kelas: ${studentData.class}`;
      document.getElementById('cert-total-score').innerText = `${totalScore} / 100`;
      
      const predEl = document.getElementById('cert-predicate');
      predEl.innerText = predicate;
      predEl.className = `mt-1 inline-block px-4 py-1 rounded-full text-xs font-black uppercase ${badgeBg}`;

      // Date
      const today = new Date();
      const options = { year: 'numeric', month: 'long', day: 'numeric' };
      document.getElementById('cert-date').innerText = today.toLocaleDateString('id-ID', options);

      // Trigger Celebration Effects
      confetti({ particleCount: 100, spread: 100, origin: { y: 0.5 } });

      document.getElementById('certificate-modal').classList.remove('hidden');
    }

    function closeCertificate() {
      document.getElementById('certificate-modal').classList.add('hidden');
      showScreen('screen-levels');
      renderLevelGrid();
    }

    // Initialize UI on load
    window.onload = function() {
      showIdentityScreen();
    };
  </script>
